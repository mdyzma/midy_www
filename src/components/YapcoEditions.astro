---
import rows from '../data/yapco-editions.json';
const labels: Record<string, string> = { '●': 'on by default', '○': 'optional module', '—': 'not included in this edition' };
const groups = rows.reduce<string[][][]>((groups, row) => {
  if (row.slice(1).every(cell => !cell)) groups.push([row]);
  else groups[groups.length - 1].push(row);
  return groups;
}, []);
---
<section class="mt-14" lang="en" aria-labelledby="yapco-editions">
  <h2 id="yapco-editions" class="mb-4 text-3xl font-bold">What each edition includes</h2>
  <p class="mb-5 text-sm text-slate-400">● on by default · ○ optional module · — not included in this edition</p>
  <div class="relative overflow-x-auto rounded-xl border border-slate-700 focus-visible:outline-2 focus-visible:outline-primary" tabindex="0" role="region" aria-label="Planner edition comparison — scroll horizontally on small screens">
    <table class="w-full min-w-[680px] border-collapse text-sm">
      <caption class="sr-only">Features in the Basic, Balance, and Recovery Edition planners</caption>
      <thead class="bg-slate-800">
        <tr><th scope="col" class="p-4 text-left">Element</th>{['Basic', 'Balance', 'Recovery Edition'].map(title => <th scope="col" class="p-4 text-center">{title}</th>)}</tr>
      </thead>
      {groups.map(group => <tbody>
        <tr class="border-t border-slate-700 bg-slate-800/70"><th colspan="4" scope="rowgroup" class="p-4 text-left font-semibold text-primary">{group[0][0]}</th></tr>
        {group.slice(1).map(row => <tr class="border-t border-slate-700/60">
          <th scope="row" class="p-4 text-left font-normal leading-relaxed text-slate-300">{row[0]}</th>
          {row.slice(1).map(cell => <td class="p-4 text-center text-slate-200">{labels[cell] ? <><span aria-hidden="true">{cell}</span><span class="sr-only">{labels[cell]}</span></> : cell}</td>)}
        </tr>)}
      </tbody>)}
    </table>
  </div>
  <p class="mt-4 text-sm text-slate-400">Source: <a href="https://planner.midysmart.com/docs/en/guides/editions/#what-each-edition-contains" class="text-primary underline underline-offset-4">Yapco documentation — “Day by Day” editions</a>.</p>
</section>
