---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Stack from '../components/Stack.astro';
import { getEntry } from 'astro:content';
import { Server, ArrowRight } from '@lucide/astro';
const project = await getEntry('projects', 'homelab');
if (!project) throw new Error('Homelab project content is missing.');
---
<Layout title="Michal Dyzma | Data & AI Automation" description="Michal Dyzma — data engineering, AI integration, and process automation. ETL pipelines, vector RAG systems, and autonomous agent workflows.">
  <Hero />
  <About />
  <Stack />
  <section id="homelab" class="border-y border-slate-700 py-24">
    <div class="container mx-auto px-6">
      <div class="glass-panel max-w-3xl p-8">
        <Server size={36} class="mb-5 text-primary" aria-hidden="true" />
        <h2 class="mb-4 text-3xl font-bold">Homelab</h2>
        <p class="mb-6 leading-relaxed text-slate-400">{project.data.description}</p>
        <a href="/homelab/" class="inline-flex items-center gap-2 font-medium text-primary">Explore the homelab <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</Layout>
