---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  if (new Set(posts.map(post => post.data.slug)).size !== posts.length) throw new Error('Published posts must have unique slugs.');
  return posts.map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | Michal Dyzma`} description={post.data.description}>
  <div class="container mx-auto px-6 pt-28"><a href="/blog/" class="inline-flex items-center gap-2 text-primary"><ArrowLeft size={18} aria-hidden="true" /> All engineering logs</a></div>
  <article class="developer-article"><Content /></article>
</Layout>
<script>import '../../../scripts/article-charts.js';</script>
