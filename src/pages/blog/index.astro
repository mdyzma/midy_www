---
import Layout from '../../layouts/Layout.astro';
import BlogExplorer from '../../components/BlogExplorer.astro';
---
<Layout title="Engineering Logs | Michal Dyzma" description="Notes on data engineering, AI architecture, developer tools, and automation by Michal Dyzma.">
  <header class="border-b border-slate-800 pt-36 pb-16">
    <div class="container mx-auto px-6">
      <p class="mb-4 font-mono text-sm text-sky-400">// ENGINEERING NOTES</p>
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">Engineering Logs</h1>
      <p class="max-w-2xl text-xl text-slate-400">Thoughts on data engineering patterns, AI system architecture, and automation workflows.</p>
    </div>
  </header>
  <section class="container mx-auto px-6 py-16" aria-label="Article archive"><BlogExplorer /></section>
</Layout>
